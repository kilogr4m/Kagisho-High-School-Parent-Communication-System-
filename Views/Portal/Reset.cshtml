@{ Layout=null; ViewData["Title"]="Choose new password | Kagisho Connect"; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"]</title><link rel="stylesheet" href="/css/site.css"/></head><body class="login-body"><main class="auth-center"><div class="login-card"><div class="brand"><span class="brand-icon">✦</span><div><strong>Kagisho<span>Connect</span></strong></div></div><span class="eyebrow">ACCOUNT RECOVERY</span><h2>Choose a new password.</h2>
@if(ViewBag.Success != null){<div class="auth-success">@ViewBag.Success <a href="/login">Sign in</a></div>}
else {<form class="login-form" method="post" action="/reset-password">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="form-error" role="alert"></div><input type="hidden" name="accessToken" id="inviteToken"/><label class="field"><span>New password (at least 12 characters)</span><input type="password" name="password" minlength="12" required/></label><label class="field"><span>Confirm password</span><input type="password" name="confirmPassword" minlength="12" required/></label><button type="submit" class="button primary login-button">Save new password →</button></form>}
<div class="login-help" id="inviteHelp">Open the password reset link sent to your email.</div><div class="auth-register"><a href="/login">Back to sign in</a></div></div></main><script src="/js/auth-links.js" defer></script></body></html>
