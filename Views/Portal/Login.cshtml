@{
    Layout = null;
    ViewData["Title"] = "Sign in | Kagisho Connect";
}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"]</title><link rel="stylesheet" href="/css/site.css"/></head>
<body class="login-body"><div class="login-grid">
  <section class="login-story"><div class="brand login-brand"><span class="brand-icon">✦</span><div><strong>Kagisho<span>Connect</span></strong><small>Better together, every day.</small></div></div><div class="login-story-text"><div class="eyebrow light">STAFF AND SCHOOL MANAGEMENT</div><h1>Every learner.<br/>Every family.<br/><em>Closer together.</em></h1><p>A thoughtful space for teachers to connect with families, manage classroom updates and make each day a little easier.</p></div><div class="login-story-bottom">Kagisho Connect · School Staff</div></section>
  <main class="login-panel"><div class="login-card"><span class="eyebrow">WELCOME BACK</span><h2>Good to see you.</h2><p>Sign in to your school workspace using your email address and password.</p>
    <form method="post" action="/login" class="login-form">@Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="form-error" role="alert"></div>
      <label class="field"><span>Email address</span><input type="email" name="email" maxlength="254" autocomplete="username" placeholder="you@example.com" required autofocus/></label>
      <label class="field"><span>Password</span><input type="password" name="password" autocomplete="current-password" placeholder="Your password" required/></label>
      <div class="auth-links"><a href="/forgot-password">Forgot password?</a></div>
      <button class="button primary login-button" type="submit">Sign in <span aria-hidden="true">→</span></button>
    </form><div class="auth-register">Parents and guardians register through the Kagisho Connect mobile application.</div><div class="login-help">Teachers and school administrators receive an invitation from their school's administrator.</div>
  </div></main>
</div></body></html>
